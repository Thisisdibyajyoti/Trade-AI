# ---------------------------------------------------------------------------
# TradeAI environment variables
#
# Copy this file to ".env" and fill in the keys you have.
#   - Backend keys are read from the process environment (os.getenv).
#   - The VITE_* keys belong to the frontend and must live in "frontend/.env".
#
# Every key below is OPTIONAL. When a key is missing the app does not crash:
# it falls back to a free source and says which fallback is active.
# ---------------------------------------------------------------------------

# --- Backend -----------------------------------------------------------------

# Plain-English explanation layer (Phase 10). If unset, a template-based
# explanation is shown instead of calling OpenAI.
OPENAI_API_KEY=

# Live US-equity ticks. If unset, US stocks fall back to yfinance and are
# labelled DELAYED instead of LIVE.
FINNHUB_API_KEY=

# --- Frontend (put these in frontend/.env, NOT here) -------------------------

# Base URL of the FastAPI backend including the /api suffix.
# VITE_API_BASE=http://localhost:8000/api
